# Queen of Excellence — Production (LWS)

# --- Base de données MySQL (LWS) ---
# Utilisateur : c2852916c_queenofex_user
# Base        : c2852916c_queenofex   ← vérifier dans cPanel → MySQL
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=c2852916c_queenofex_user
DATABASE_PASSWORD=PASSWORD
DATABASE_NAME=c2852916c_queenofex

# Alternative (une seule ligne) — @ dans le mot de passe → %40
# DATABASE_URL=mysql://c2852916c_queenofex_user:PASSWORD@localhost:3306/c2852916c_queenofex

# --- Authentification ---
AUTH_SECRET="changez-moi-long-secret-aleatoire"
NEXTAUTH_URL="https://queenofexcellence.com"
AUTH_TRUST_HOST="true"

# --- KKiaPay (paiements RÉELS) ---
KKIAPAY_PUBLIC_KEY="votre-cle-publique"
KKIAPAY_PRIVATE_KEY="votre-cle-privee"
KKIAPAY_SECRET="votre-secret"
KKIAPAY_WEBHOOK_SECRET="votre-webhook-secret"
KKIAPAY_SANDBOX="false"

# --- Node ---
NODE_ENV="production"
NODE_OPTIONS="--max-old-space-size=512"
