# ============================================
# Queen of Excellence — Variables d'environnement
# ============================================
# Copiez ce fichier en .env.local (jamais commité)
# ou configurez ces variables sur votre plateforme (Vercel, etc.)

# --- Base de données ---
# Option A — Dev local avec Docker (recommandé) :
#   docker compose up -d && npm run db:push && npm run db:seed
# Option B — PostgreSQL hébergé (Neon, Supabase, cPanel, etc.) :
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=10&sslmode=require"

# --- Authentification ---
# Générez une clé secrète avec : openssl rand -base64 32
AUTH_SECRET="votre-secret-ici"

# --- FeexPay (Paiements) ---
FEEXPAY_API_KEY=""
FEEXPAY_SHOP_ID=""
# FEEXPAY_API_URL="https://api.feexpay.me"
# FEEXPAY_WEBHOOK_SECRET=""
# FEEXPAY_MODE="LIVE"  # ou "SANDBOX" pour les tests
# FEEXPAY_ENABLE_SANDBOX="false"

# --- URL de l'application ---
# NEXTAUTH_URL="https://votre-domaine.com"
